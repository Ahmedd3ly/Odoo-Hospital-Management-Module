<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="action_report_prescription" model="ir.actions.report">
    <field name="name">Prescription Slip</field>
    <field name="model">hospital.appointment</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">om_hospital.report_prescription</field>
    <field name="print_report_name">'Prescription - %s' % (object.name or '').replace('/', '-')</field>
    <field name="binding_model_id" ref="model_hospital_appointment" />
    <field name="binding_type">report</field>
  </record>

  <record id="action_report_appointment_slip" model="ir.actions.report">
    <field name="name">Appointment Slip</field>
    <field name="model">hospital.appointment</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">om_hospital.report_appointment_slip</field>
    <field name="print_report_name">'Appointment - %s' % (object.name or '').replace('/', '-')</field>
    <field name="binding_model_id" ref="model_hospital_appointment" />
    <field name="binding_type">report</field>
  </record>

  <record id="action_report_discharge_summary" model="ir.actions.report">
    <field name="name">Discharge Summary</field>
    <field name="model">hospital.admission</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">om_hospital.report_discharge_summary</field>
    <field name="print_report_name">'Discharge - %s' % (object.name or '').replace('/', '-')</field>
    <field name="binding_model_id" ref="model_hospital_admission" />
    <field name="binding_type">report</field>
  </record>

</odoo>
