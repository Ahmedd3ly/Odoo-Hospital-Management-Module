<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== Clinician tab on the employee form ===================== -->
    <record id="view_employee_form_inherit_hospital" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.hospital</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_hospital_appointments" type="object"
                        class="oe_stat_button" icon="calendar_today"
                        invisible="not is_clinician">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="hospital_appointment_count"/>
                        </span>
                        <span class="o_stat_text">Appointments</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Hospital" name="hospital_clinician">
                    <group>
                        <group string="Clinical Profile">
                            <field name="is_clinician"/>
                            <field name="clinician_role" invisible="not is_clinician"
                                   required="is_clinician"/>
                            <field name="hospital_specialty_id" invisible="not is_clinician"/>
                            <field name="hospital_license_number" invisible="not is_clinician"/>
                            <field name="hospital_clinic_ids" widget="many2many_tags"
                                   invisible="not is_clinician"/>
                        </group>
                        <group string="Fees" invisible="not is_clinician">
                            <field name="hospital_currency_id" invisible="1"/>
                            <field name="hospital_consultation_fee"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============================ Clinicians menu ============================ -->

    <!-- List View -->
    <record id="view_hospital_clinician_list" model="ir.ui.view">
        <field name="name">hospital.clinician.list</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <list string="Clinicians">
                <field name="name"/>
                <field name="clinician_role"/>
                <field name="hospital_specialty_id"/>
                <field name="hospital_license_number"/>
                <field name="work_email" optional="show"/>
                <field name="hospital_currency_id" column_invisible="True"/>
                <field name="hospital_consultation_fee"/>
            </list>
        </field>
    </record>

    <!-- Window Action: employees flagged as clinicians -->
    <record id="action_hospital_clinician" model="ir.actions.act_window">
        <field name="name">Clinicians</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_clinician', '=', True)]</field>
        <field name="context">{'default_is_clinician': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first clinician!
            </p>
            <p>
                Clinicians are employees flagged for clinical work. They are assigned to
                appointments and carry their specialty, license and consultation fee.
            </p>
        </field>
    </record>
    <record id="action_hospital_clinician_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_hospital_clinician_list"/>
        <field name="act_window_id" ref="action_hospital_clinician"/>
    </record>
    <record id="action_hospital_clinician_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr.view_employee_form"/>
        <field name="act_window_id" ref="action_hospital_clinician"/>
    </record>

</odoo>
