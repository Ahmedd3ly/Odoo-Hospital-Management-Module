<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- List View -->
  <record id="view_hospital_ward_list" model="ir.ui.view">
    <field name="name">hospital.ward.list</field>
    <field name="model">hospital.ward</field>
    <field name="arch" type="xml">
      <list string="Wards">
        <field name="name" />
        <field name="code" />
        <field name="ward_type" />
        <field name="location" />
        <field name="bed_count" />
        <field name="occupied_count" />
        <field name="available_count" />
        <field name="active" column_invisible="True" />
      </list>
    </field>
  </record>

  <!-- Form View -->
  <record id="view_hospital_ward_form" model="ir.ui.view">
    <field name="name">hospital.ward.form</field>
    <field name="model">hospital.ward</field>
    <field name="arch" type="xml">
      <form string="Ward">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_beds" type="object" class="oe_stat_button" icon="bed">
              <div class="o_field_widget o_stat_info">
                <span class="o_stat_value">
                  <field name="available_count" /> / <field name="bed_count" />
                </span>
                <span class="o_stat_text">Beds Available</span>
              </div>
            </button>
          </div>
          <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active" />
          <div class="oe_title">
            <label for="name" />
            <h1>
              <field name="name" placeholder="e.g. General Ward" />
            </h1>
          </div>
          <group>
            <group string="Ward Details">
              <field name="code" placeholder="e.g. GEN" />
              <field name="ward_type" />
              <field name="location" />
              <field name="active" invisible="1" />
            </group>
          </group>
          <notebook>
            <page string="Beds" name="beds">
              <field name="bed_ids">
                <list editable="bottom" string="Beds">
                  <field name="name" />
                  <field name="is_occupied" />
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter />
      </form>
    </field>
  </record>

  <!-- Search View -->
  <record id="view_hospital_ward_search" model="ir.ui.view">
    <field name="name">hospital.ward.search</field>
    <field name="model">hospital.ward</field>
    <field name="arch" type="xml">
      <search string="Ward Search">
        <field name="name" string="Ward / Code"
          filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]" />
        <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]" />
        <separator />
        <filter string="Type" name="group_type" context="{'group_by': 'ward_type'}" />
      </search>
    </field>
  </record>

  <!-- Window Action -->
  <record id="action_hospital_ward" model="ir.actions.act_window">
    <field name="name">Wards</field>
    <field name="res_model">hospital.ward</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Create your first ward!
      </p>
      <p>
        Wards group beds for inpatient admissions, for example a General Ward or an ICU.
      </p>
    </field>
  </record>

</odoo>
