<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- List View (editable inline) -->
  <record id="view_hospital_specialty_list" model="ir.ui.view">
    <field name="name">hospital.specialty.list</field>
    <field name="model">hospital.specialty</field>
    <field name="arch" type="xml">
      <list string="Specialties" editable="bottom">
        <field name="name" />
      </list>
    </field>
  </record>

  <!-- Window Action -->
  <record id="action_hospital_specialty" model="ir.actions.act_window">
    <field name="name">Specialties</field>
    <field name="res_model">hospital.specialty</field>
    <field name="view_mode">list</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Add your first medical specialty!
      </p>
    </field>
  </record>

</odoo>
