<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_hospital_bed_list" model="ir.ui.view">
        <field name="name">hospital.bed.list</field>
        <field name="model">hospital.bed</field>
        <field name="arch" type="xml">
            <list string="Beds" decoration-warning="is_occupied">
                <field name="ward_id"/>
                <field name="name"/>
                <field name="is_occupied"/>
                <field name="current_admission_id" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hospital_bed_form" model="ir.ui.view">
        <field name="name">hospital.bed.form</field>
        <field name="model">hospital.bed</field>
        <field name="arch" type="xml">
            <form string="Bed">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="ward_id" options="{'no_create': True}"/>
                            <field name="name"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="is_occupied"/>
                            <field name="current_admission_id" invisible="not current_admission_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hospital_bed_search" model="ir.ui.view">
        <field name="name">hospital.bed.search</field>
        <field name="model">hospital.bed</field>
        <field name="arch" type="xml">
            <search string="Bed Search">
                <field name="name" string="Bed / Ward" filter_domain="['|', ('name', 'ilike', self), ('ward_id.name', 'ilike', self)]"/>
                <filter string="Available" name="filter_available" domain="[('is_occupied', '=', False)]"/>
                <filter string="Occupied" name="filter_occupied" domain="[('is_occupied', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Ward" name="group_ward" context="{'group_by': 'ward_id'}"/>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_hospital_bed" model="ir.actions.act_window">
        <field name="name">Beds</field>
        <field name="res_model">hospital.bed</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first bed!
            </p>
        </field>
    </record>

</odoo>
