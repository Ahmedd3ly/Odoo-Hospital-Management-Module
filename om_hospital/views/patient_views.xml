<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_hospital_patient_list" model="ir.ui.view">
        <field name="name">hospital.patient.list</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <list string="Patient List" decoration-danger="deceased" sample="1">
                <field name="reference" readonly="1"/>
                <field name="name" string="Patient Name"/>
                <field name="date_of_birth"/>
                <field name="age" optional="hide"/>
                <field name="gender"/>
                <field name="blood_group" string="Blood Type"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="deceased" widget="boolean_toggle" optional="hide"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hospital_patient_form" model="ir.ui.view">
        <field name="name">hospital.patient.form</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <form string="Patient Form">
                <sheet>
                    <!-- Stat buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_appointments" type="object"
                                class="oe_stat_button" icon="calendar_today">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="appointment_count"/>
                                </span>
                                <span class="o_stat_text">Appointments</span>
                            </div>
                        </button>
                    </div>

                    <!-- Ribbon and avatar -->
                    <widget name="web_ribbon" title="Deceased" bg_color="bg-danger"
                            invisible="not deceased"/>
                    <field name="image_1920" widget="image" class="oe_avatar"/>

                    <!-- Title: reference + deceased toggle -->
                    <div class="oe_title">
                        <h4>
                            <field name="reference" readonly="1"/>
                        </h4>
                        <label for="name" string="Name" invisible="id == True"/>
                        <h2>
                            <field name="name" required="1"/>
                        </h2>
                        <div class="d-flex align-items-center gap-2">
                            <label for="deceased"/>
                            <field name="deceased" widget="boolean_toggle"/>
                        </div>
                    </div>

                    <group>
                        <group string="Personal Information">
                            <field name="date_of_birth"/>
                            <field name="age"/>
                            <field name="is_minor" invisible="1"/>
                            <field name="guardian_id" invisible="not is_minor" required="is_minor"
                                   options="{'no_create_edit': True}"/>
                            <field name="gender"/> 
                            <field name="id_type"/>
                            <field name="id_number" invisible="not id_type" required="id_type"/>
                        </group>
                        <group string="Contact &amp; Details">
                            <field name="partner_id" required="0" readonly="id"
                                   domain="[('is_company', '=', False), ('is_patient', '=', False)]"
                                   options="{'no_create': True}"
                                   placeholder="Leave empty to create a new contact"/>
                            <field name="active" invisible="1"/>
                            <field name="parent_id" string="Company / Insurer"
                                   domain="[('is_company', '=', True)]"
                                   options="{'no_create': True}"/>
                            <field name="contract_id" invisible="not contract_id"/>
                            <field name="blood_group" string="Blood Type"/>
                            <field name="phone" required="1"/>
                            <field name="email" required="1"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create_edit': True}"
                                   placeholder="Select medical tags..."/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Medical Conditions" name="medical_conditions">
                            <field name="condition_ids">
                                <list editable="bottom" string="Allergies &amp; Chronic Conditions"
                                      decoration-danger="severity == 'severe'">
                                    <field name="condition_type"/>
                                    <field name="name"/>
                                    <field name="severity"/>
                                    <field name="since" optional="show"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Emergency Contacts" name="emergency_contacts">
                            <field name="emergency_contact_ids">
                                <list editable="bottom" string="Emergency Contacts">
                                    <field name="partner_id"/>
                                    <field name="relationship"/>
                                    <field name="phone"/>
                                    <field name="is_primary"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hospital_patient_search" model="ir.ui.view">
        <field name="name">hospital.patient.search</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <search string="Patient Search">
                <field name="reference"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="id_number"/>
                <filter string="Male" name="filter_male" domain="[('gender', '=', 'male')]"/>
                <filter string="Female" name="filter_female" domain="[('gender', '=', 'female')]"/>
                <separator/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Gender" name="group_gender" context="{'group_by': 'gender'}"/>
                <filter string="Blood Type" name="group_blood_group" context="{'group_by': 'blood_group'}"/>
                <searchpanel>
                    <field name="gender" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first hospital patient!
            </p>
            <p>
                Maintain patient records, track medical history, monitor appointment counts, and manage demographic details.
            </p>
        </field>
    </record>

</odoo>
