<?xml version="1.0" encoding="utf-8"?>
<odoo>
      <record id="view_order_form_inherit_hospital" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.hospital</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="appointment_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                <field name="admission_id" options="{'no_create': True}" invisible="not admission_id" readonly="state != 'draft'"/>
                <field name="hospital_contract_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                <field name="hospital_payer" invisible="not hospital_contract_id" readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
  
    <!-- Window Action -->
    <record id="action_view_sale_order" model="ir.actions.act_window">
        <field name="name">Sale Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('appointment_id', '!=', False), ('admission_id', '!=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first sale order!
            </p>
        </field>
    </record>
    
</odoo>

